# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# SECURITY: Generate a strong random secret key
# Use: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-MUST-CHANGE-THIS

# Database
DATABASE_URL=sqlite:///keysaver.db

# Email Configuration (Gmail example)
# For Gmail: Enable 2FA and generate App Password at https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Frontend URL (update for production deployment)
FRONTEND_URL=http://localhost:5173
